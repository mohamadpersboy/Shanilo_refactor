# Shanilo — ENV contract (placeholders only; never put real values in this file).
# Local: copy to .env.local. Vercel: set the same names in Preview and Production.
# "Required for" tells you when a variable must be set. Phase 1 needs none of them.

# ── App ─────────────────────────────────────────────
# Public. Optional. Base URL of this deployment (no trailing slash).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Server. Optional. One of: debug | info | warn | error. Default: info.
LOG_LEVEL=info

# ── Database (SECRET) — required from Phase 3 ───────
MONGODB_URI=

# ── Cloudinary (SECRET) — required from Phase 5 ─────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Payment: Mellat (SECRET) — required from Phase 12 ─
MELLAT_TERMINAL_ID=
MELLAT_USERNAME=
MELLAT_PASSWORD=

# ── Payment: ZarinPal (SECRET) — required from Phase 12 ─
ZARINPAL_MERCHANT_ID=

# ── SMS: SMS.ir (SECRET) — required from Phase 4 ────
SMSIR_API_KEY=
SMSIR_LINE_NUMBER=

# ── Email: SMTP (SECRET) — optional; set all or none ─
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
